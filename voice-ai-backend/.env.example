# GramCare AI Backend Environment Configuration (Example Placeholders)

PORT=5000
FRONTEND_URL=http://localhost:3000

# MongoDB Atlas Connection & JWT Secret
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net
JWT_SECRET=your_jwt_secret_here

# Nodemailer SMTP Email Configuration for OTP & Clinical Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_password
SMTP_FROM=GramCare AI <your_email@example.com>


# Gemini AI API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
